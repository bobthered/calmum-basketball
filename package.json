{
	"name": "calmum-basketball",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"setup:push": "node scripts/setup-push.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@lucide/svelte": "^0.548.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^22",
		"@types/web-push": "^3.6.4",
		"@vitest/browser-playwright": "^5.0.3",
		"bcrypt": "^6.0.0",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.4.0",
		"is-dark-color": "^1.2.0",
		"mongodb": "^6.20.0",
		"mongoose": "^8.19.2",
		"playwright": "^1.55.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.0",
		"valibot": "^1.1.0",
		"vite": "^8.0.12",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#components": "./src/components/index.ts",
		"#components/*": "./src/components/*"
	},
	"engines": {
		"node": ">=22.17.0"
	},
	"dependencies": {
		"sveltewind": "^4.15.0",
		"web-push": "^3.6.7"
	}
}
